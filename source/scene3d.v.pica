; Deep Shelter 3D fixed side-view textured vertex shader

; Uniforms
.fvec projection[4], modelView[4]

; Constants
; Three branchless cel-light bands tuned for the native 400x240 display:
; 0.78 in shadow, 0.89 in mid light and 1.00 on directly lit faces.
.constf constants(0.0, 1.0, 0.78, 0.11)
.constf celThresholds(0.35, 0.72, 0.0, 0.0)
.constf lightDirection(-0.408248, -0.408248, 0.816497, 0.0)
.constf colourLift(0.08, 0.08, 0.08, 0.0)
; Scale the compact multifloor cutaway 1.8x around world centre (200, 120).
.constf framing(1.8, -160.0, -96.0, 0.0)
.alias ones constants.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs
.alias inpos v0
.alias intex v1
.alias innormal v2
.alias inclr v3

.proc main
    ; Homogeneous world position with a closer default composition.
    mov r5, framing
    mul r0.xy, inpos, r5.x
    add r0.x, r0.x, r5.y
    add r0.y, r0.y, r5.z
    mov r0.z, inpos.z
    mov r0.w, ones

    ; Camera/view transform
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    ; Perspective projection
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    ; Quantize max(dot(N, L), 0) into three cel bands without flow control.
    mov r3, lightDirection
    mov r4, constants
    dp3 r2.x, innormal, r3
    max r2.x, r2.x, r4.x
    sge r7.x, r2.x, celThresholds.x
    sge r7.y, r2.x, celThresholds.y
    mul r7.x, r7.x, r4.w
    mul r7.y, r7.y, r4.w
    add r2.x, r4.z, r7.x
    add r2.x, r2.x, r7.y

    ; Room asset atlas coordinates and cel-lit vertex tint. A restrained
    ; display lift preserves dark-room readability without washing out the bands.
    mov outtc0, intex
    mul r6.xyz, inclr, r2.x
    mov r5, colourLift
    add outclr.xyz, r6, r5
    mov outclr.w, inclr.w
    end
.end
