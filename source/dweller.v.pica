; Deep Shelter 3D unlit side-facing dweller billboard shader

.fvec projection[4], modelView[4]
.constf constants(0.0, 1.0, 0.0, 0.0)
.constf framing(1.8, -160.0, -96.0, 0.0)
.alias ones constants.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias innormal v2
.alias inclr v3

.proc main
    mov r5, framing
    mul r0.xy, inpos, r5.x
    add r0.x, r0.x, r5.y
    add r0.y, r0.y, r5.z
    mov r0.z, inpos.z
    mov r0.w, ones

    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    mov outtc0, intex
    mov outclr, inclr
    end
.end
