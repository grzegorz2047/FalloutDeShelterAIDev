; Deep Shelter 3D fixed side-view textured vertex shader

; Uniforms
.fvec projection[4], modelView[4]

; Constants
.constf constants(0.0, 1.0, 0.42, 0.58)
.constf lightDirection(-0.408248, -0.408248, 0.816497, 0.0)
.alias zero constants.xxxx
.alias ones constants.yyyy
.alias ambient constants.zzzz
.alias diffuse constants.wwww

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs
.alias inpos v0
.alias intex v1
.alias innormal v2
.alias inclr v3

.proc main
    ; Homogeneous world position
    mov r0.xyz, inpos
    mov r0.w, ones

    ; Camera/view transform
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    ; Perspective projection
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    ; Cheap fixed directional lighting: ambient + max(dot(N, L), 0) * diffuse.
    dp3 r2.x, innormal, lightDirection
    max r2.x, r2.x, zero
    mul r2.x, r2.x, diffuse
    add r2.x, r2.x, ambient

    ; Generated material atlas coordinates and lit vertex tint.
    mov outtc0, intex
    mul outclr.xyz, inclr, r2.x
    mov outclr.w, inclr.w
    end
.end
